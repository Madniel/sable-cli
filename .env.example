# Copy to .env (git-ignored) or export these in your shell.

# One of these, depending on the provider you use.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional overrides.
# SABLE_PROVIDER=anthropic
# SABLE_MODEL=claude-sonnet-4-5
# SABLE_MAX_TOKENS=8192
# SABLE_APPROVAL=prompt
# SABLE_MAX_STEPS=40
# SABLE_COMPACT_AT=120000
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com/v1
